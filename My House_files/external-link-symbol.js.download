(function () {
    // COPIED designsystem.digital.gov/assets/img/usa-icons/launch.svg
    const icon =
        '<svg xmlns="http://www.w3.org/2000/svg" width="0.75em" height="0.75em" style="vertical-align: middle; fill: currentColor;" viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>';

    const modifyLink = (link) => {
        const linkHost = link.host.toLowerCase();

        const isCERNLink =
            linkHost === 'cern.ch' ||
            linkHost === 'web.cern.ch' ||
            linkHost.endsWith('.cern.ch') ||
            linkHost.endsWith('.web.cern.ch') ||
            linkHost.endsWith('.cern') ||
            linkHost.startsWith('#') ||
            linkHost.length === 0;

        const onlyHasSpan =
            link.children.length === 1 &&
            link.children[0].tagName.toLowerCase() === 'span';
        const onlyContainsText =
            link.children.length === 0 && link.textContent.trim().length > 0;

        const textWithExternalLink = onlyHasSpan || onlyContainsText;

        if (
            link.host !== window.location.host &&
            !link.href.startsWith('tel:') &&
            !link.href.startsWith('mailto:') &&
            !isCERNLink &&
            textWithExternalLink
        ) {
            link.innerHTML = link.innerHTML + ' ' + icon;
        }
    };

    function addExternalLinkIcons() {
        const content =
            document.querySelector('.wp-sites-blocks') || document.body;
        const links = content.querySelectorAll('a');

        links.forEach(modifyLink);
    }
    window.addEventListener('DOMContentLoaded', addExternalLinkIcons, false);
})();
